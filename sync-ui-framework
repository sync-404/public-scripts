        Background = Color3.fromRGB(13, 15, 18), Container = Color3.fromRGB(20, 22, 27),
        Border = Color3.fromRGB(35, 38, 45), Accent = Color3.fromRGB(0, 212, 255), 
        TextMain = Color3.fromRGB(240, 240, 240), TextDim = Color3.fromRGB(150, 150, 160), Font = Enum.Font.GothamMedium
    },
